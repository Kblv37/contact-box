# Database (Neon / PostgreSQL). Get it from the Neon Dashboard -> Connect.
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign auth tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional: used by `serve-local.js` to expose the local server on a custom port.
PORT=3000